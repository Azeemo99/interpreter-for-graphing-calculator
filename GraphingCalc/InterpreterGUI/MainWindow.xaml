<Window x:Class="InterpreterGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interpreter" Height="Auto" Width="Auto">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,5" AcceptsReturn="True" 
                 TextWrapping ="Wrap"
                 HorizontalAlignment="Stretch" 
                 VerticalAlignment="Stretch" Text="Enter expression" 
                 GotFocus="InputBox_GotFocus"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button x:Name="btnOpenPlot" Content="Open Plot" Width="120" Height="35" Margin="5,0" Click="btnOpenPlot_Click"/>
            <Button Content="Evaluate" Width="120" Height="35" Margin="5,0" Click="Evaluate_Click" Background="#FF007ACC" Foreground="White"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Output:" VerticalAlignment="Center"/>
            <TextBox x:Name="ResultBox" Grid.Column="1" Height="30" IsReadOnly="True" 
                     VerticalContentAlignment="Center" Margin="5,0,0,0"/>
            <TextBox x:Name="ErrorBox" Grid.Column="1" Height="30" IsReadOnly="True" 
                     Foreground="Red" Visibility="Collapsed" VerticalContentAlignment="Center" Margin="5,0,0,0"/>
        </Grid>
    </Grid>
</Window>
